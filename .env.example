# Session (32+ char secret; generate with: openssl rand -hex 32)
NUXT_SESSION_PASSWORD=

# Cloudflare Turnstile (get from Cloudflare dashboard; omit locally to skip server verification)
NUXT_TURNSTILE_SECRET_KEY=
# Optional local override: Cloudflare's dummy pass site key so Turnstile passes offline/locally
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Plunk transactional & newsletter email API key (get from useplunk.com)
NUXT_PLUNK_API_KEY=

# Telegram bot token for admin queue notifications (optional; unset disables them)
NUXT_TELEGRAM_BOT_TOKEN=

# Public site origin (used in emails, canonical links, and sitemap)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# CARTO basemap tiles (free key from https://carto.com/basemaps/apikey/)
# Local dev only; production reads this from a Cloudflare Pages secret, not .env.
NUXT_PUBLIC_CARTO_API_KEY=
